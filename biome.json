{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
  "files": { "includes": ["**", "!**/dist", "!**/node_modules", "!pnpm-lock.yaml"] },
  "formatter": { "enabled": true, "indentStyle": "space", "indentWidth": 2, "lineWidth": 100 },
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "linter": {
    "enabled": true,
    "rules": { "preset": "recommended" }
  },
  "overrides": [
    {
      "includes": ["packages/core/src/**", "packages/contracts/src/**"],
      "linter": {
        "rules": {
          "suspicious": { "noConsole": "error" },
          "correctness": { "noNodejsModules": "error", "noProcessGlobal": "error" },
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@awesec/cli": "Dependency direction is cli -> core -> contracts.",
                  "commander": "Argument parsing belongs in packages/cli."
                }
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/contracts/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "@awesec/core": "contracts must not depend on core.",
                  "@awesec/cli": "contracts must not depend on cli.",
                  "commander": "Argument parsing belongs in packages/cli."
                }
              }
            }
          }
        }
      }
    }
  ]
}
